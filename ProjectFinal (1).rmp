                  <parameter key="DAY_PART" value="if(OCC_HOUR &gt;= 6 &amp;&amp; OCC_HOUR &lt; 12, &quot;Morning&quot;,&#10;    if(OCC_HOUR &gt;= 12 &amp;&amp; OCC_HOUR &lt; 18, &quot;Afternoon&quot;,&#10;        if(OCC_HOUR &gt;= 18 &amp;&amp; OCC_HOUR &lt; 21, &quot;Evening&quot;,&#10;            if(OCC_HOUR &gt;= 21 || OCC_HOUR &lt; 6, &quot;Night&quot;, &quot;UNKNOWN&quot;))))"/>
                  <parameter key="BIKE_TARGET" value="if(BIKE_TYPE == &quot;MOUNTAIN BIKE&quot; &#10;    || BIKE_TYPE == &quot;ROAD/GRAVEL BIKE&quot;&#10;    || BIKE_TYPE == &quot;RACE BIKE&quot;&#10;    || BIKE_TYPE == &quot;TOURING BIKE&quot;, &quot;COMMON TARGETS&quot;,&#10;&#10;    if(BIKE_TYPE == &quot;TANDEM BIKE&quot;&#10;        || BIKE_TYPE == &quot;FOLDING BIKE&quot;&#10;        || BIKE_TYPE == &quot;BMX BIKE&quot;&#10;        || BIKE_TYPE == &quot;TREKKING/TRAIL BIKE&quot;&#10;        || BIKE_TYPE == &quot;RECUMBENT BIKE&quot;, &quot;UNCOMMON TARGETS&quot;,&#10;&#10;        if(BIKE_TYPE == &quot;ELECTRIC BIKE&quot;&#10;            || BIKE_TYPE == &quot;SCOOTER/SMALL COMMUTER BIKE&quot;, &quot;ELECTRIC TARGETS&quot;,&#10;&#10;            if(BIKE_TYPE == &quot;OTHER&quot; &#10;                || BIKE_TYPE == &quot;UNKNOWN&quot;, &quot;UNKNOWN/OTHER TARGETS&quot;,&#10;&#10;                &quot;UNKNOWN/OTHER TARGETS&quot;&#10;            )&#10;        )&#10;    )&#10;)"/>
                  <parameter key="WEEK_PART" value="if(OCC_DOW == &quot;Monday&quot; &#10;    || OCC_DOW == &quot;Tuesday&quot; &#10;    || OCC_DOW == &quot;Wednesday&quot; &#10;    || OCC_DOW == &quot;Thursday&quot; &#10;    || OCC_DOW == &quot;Friday&quot;, &quot;WEEKDAY&quot;, &#10;&#10;    if(OCC_DOW == &quot;Saturday&quot; &#10;        || OCC_DOW == &quot;Sunday&quot;, &quot;WEEKEND&quot;, &quot;UNKNOWN&quot;)&#10;)"/>
                  <parameter key="VIOLENT_CRIME" value="if(&#10;  PRIMARY_OFFENCE == &quot;ASSAULT&quot; || &#10;  PRIMARY_OFFENCE == &quot;ASSAULT WITH WEAPON&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ASSAULT PEACE OFFICER&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ASSAULT - FORCE/THRT/IMPEDE&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ASSAULT - RESIST/ PREVENT SEIZ&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ASSAULT BODILY HARM&quot; ||&#10;  PRIMARY_OFFENCE == &quot;AGGRAVATED ASLT PEACE OFFICER&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY - MUGGING&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY WITH WEAPON&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY - BUSINESS&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY - DELIVERY PERSON&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY - HOME INVASION&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY - SWARMING&quot; ||&#10;  PRIMARY_OFFENCE == &quot;ROBBERY - OTHER&quot; ||&#10;  PRIMARY_OFFENCE == &quot;SEXUAL ASSAULT&quot; ||&#10;  PRIMARY_OFFENCE == &quot;EXTORTION&quot; ||&#10;  PRIMARY_OFFENCE == &quot;THREAT - PERSON&quot; ||&#10;  PRIMARY_OFFENCE == &quot;CARRYING CONCEALED WEAPON&quot; ||&#10;  PRIMARY_OFFENCE == &quot;MISCHIEF - ENDANGER LIFE&quot;,&#10;  &quot;VIOLENT&quot;, &#10;  if(&#10;    PRIMARY_OFFENCE == &quot;THEFT UNDER&quot; || &#10;    PRIMARY_OFFENCE == &quot;THEFT UNDER - BICYCLE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT OF EBIKE UNDER $5000&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT FROM MOTOR VEHICLE UNDER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT OVER - BICYCLE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT OVER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;DRUG - TRAF OTHER (SCHD I)&quot; ||&#10;    PRIMARY_OFFENCE == &quot;DRUG - TRAF CANNABIS (SCHD II)&quot; ||&#10;    PRIMARY_OFFENCE == &quot;DRUG - POSS COCAINE (SCHD I)&quot; ||&#10;    PRIMARY_OFFENCE == &quot;DRUG - POSS METH (SCHD I)&quot; ||&#10;    PRIMARY_OFFENCE == &quot;DRUG - POSS COCAINE (SCHD I)&quot; || &#10;    PRIMARY_OFFENCE == &quot;THEFT OF EBIKE OVER $5000&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT OF MOTOR VEHICLE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT UNDER - SHOPLIFTING&quot; ||&#10;    PRIMARY_OFFENCE == &quot;POSSESSION PROPERTY OBC UNDER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT FROM MOTOR VEHICLE OVER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT FROM MAIL / BAG / KEY&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT UNDER - DISTRACTION&quot; ||&#10;    PRIMARY_OFFENCE == &quot;TRAFFICKING PROPERTY OBC OVER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;TRAFFICKING PROPERTY OBC UNDER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;POSSESSION HOUSE BREAK INSTRUM&quot; ||&#10;    PRIMARY_OFFENCE == &quot;POSSESSION PROPERTY OBC OVER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;FRAUD UNDER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;FRAUD OVER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;FRAUD - IDENTITY/PERS W-INT&quot; ||&#10;    PRIMARY_OFFENCE == &quot;PUBLIC MISCHIEF&quot; ||&#10;    PRIMARY_OFFENCE == &quot;LANDLORD / TENANT DISPUTE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;MHA SEC 16 (FORM 2)&quot; ||&#10;    PRIMARY_OFFENCE == &quot;MISCHIEF UNDER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;MISCHIEF TO VEHICLE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;FIRE - DETERMINED&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OBSTRUCT PEACE OFFICER&quot; ||&#10;    PRIMARY_OFFENCE == &quot;PUBLIC MISCHIEF&quot; ||&#10;    PRIMARY_OFFENCE == &quot;TRESPASS AT NIGHT&quot; ||&#10;    PRIMARY_OFFENCE == &quot;INCIDENT&quot; ||&#10;    PRIMARY_OFFENCE == &quot;INCIDENT - BICYCLE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;INFORMATION ONLY&quot; ||&#10;    PRIMARY_OFFENCE == &quot;SUSPICIOUS INCIDENT&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OTHER FEDERAL STATUTE OFFENCES&quot; ||&#10;    PRIMARY_OFFENCE == &quot;INVALID GO - RMS ONLY&quot; ||&#10;    PRIMARY_OFFENCE == &quot;Jails / Detention Centres&quot; ||&#10;    PRIMARY_OFFENCE == &quot;CARELESS DRIVING- HTA&quot; ||&#10;    PRIMARY_OFFENCE == &quot;DRIVING COMPLAINT&quot; ||&#10;    PRIMARY_OFFENCE == &quot;LIQUOR - INTOXICATED&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OTHER PASSENGER TRAIN&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OTHER PASSENGER TRAIN STATION&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OTHER REGIONAL TRANSIT SYSTEM VEHICLE&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OTHER TRAIN ADMIN OR SUPPORT FACILITY&quot; ||&#10;    PRIMARY_OFFENCE == &quot;OTHER TRAIN TRACKS&quot; ||&#10;    PRIMARY_OFFENCE == &quot;TTC SUBWAY TUNNEL / OUTDOOR TRACKS&quot; ||&#10;    PRIMARY_OFFENCE == &quot;SUSPICIOUS INCIDENT&quot; ||&#10;    PRIMARY_OFFENCE == &quot;TTC SUBWAY TRAIN&quot; ||&#10;    PRIMARY_OFFENCE == &quot;THEFT OVER - SHOPLIFTING&quot;,&#10;    &quot;NONVIOLENT&quot;, &#10;    &quot;NONVIOLENT&quot; ))"/>
                  <parameter key="COVID_LOCKDOWN" value="if(&#10;  OCC_YEAR &gt; 2020 || &#10;  (OCC_YEAR == 2020 &amp;&amp; &#10;    (OCC_MONTH == &quot;March&quot; || &#10;     OCC_MONTH == &quot;April&quot; || &#10;     OCC_MONTH == &quot;May&quot;)) &amp;&amp; &#10;  (OCC_YEAR &lt; 2023 || (OCC_YEAR == 2023 &amp;&amp; &#10;    (OCC_MONTH == &quot;January&quot; || &#10;     OCC_MONTH == &quot;February&quot; || &#10;     OCC_MONTH == &quot;March&quot; || &#10;     OCC_MONTH == &quot;April&quot; || &#10;     OCC_MONTH == &quot;May&quot;))),&#10;  &quot;COVID&quot;, &#10;  &quot;NON-COVID&quot;&#10;)"/>
                </list>
                <parameter key="keep_all_columns" value="true"/>
                <parameter key="default_time_zone" value="America/Toronto"/>
